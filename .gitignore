*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# Dati di Runtime & Log di TubeDigest
# ==============================================================================
logs/
*.log
tubedigest.log
transcripts/*.txt
!transcripts/.gitkeep
last_video_id.txt

