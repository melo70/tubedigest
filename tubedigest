#!/usr/bin/env python3
"""
Application: TubeDigest
Description: Automated pipeline that monitors multiple YouTube channels via RSS,
             stores channel definitions, author profiles, prompts, and processed
             videos in SQLite, generates AI summaries with Google Gemini, and
             dispatches HTML email digests.

Usage:
    - Normal pipeline execution (e.g. via cron):
      ./tubedigest

    - One-shot check for a specific channel in database:
      ./tubedigest --channel <CHANNEL_ID_OR_NAME>

    - Process a specific YouTube video (by ID or full URL):
      ./tubedigest --add-video <VIDEO_ID_OR_URL>

    - Channel management via CLI:
      ./tubedigest --add-channel <TARGET> [--name <CHANNEL_NAME>] [--prompt <PROMPT_ID>] [--lang <LANG>]
      (TARGET accepts Channel ID, URL, @handle, or any Video URL/ID from that channel)
      ./tubedigest --set-language <CHANNEL_ID_OR_NAME> <LANG>
      ./tubedigest --disable-channel <CHANNEL_ID_OR_NAME>
      ./tubedigest --enable-channel <CHANNEL_ID_OR_NAME>
      ./tubedigest --delete-channel <CHANNEL_ID_OR_NAME>
      ./tubedigest --list-channels

    - Prompt management via CLI:
      ./tubedigest --list-prompts
      ./tubedigest --show-prompt <PROMPT_ID>

    - Video archive, summary, and export via CLI:
      ./tubedigest --list-videos
      ./tubedigest --show-video-details <VIDEO_ID_OR_URL>
      ./tubedigest --show-summary <VIDEO_ID_OR_URL>
      ./tubedigest --export-markdown <VIDEO_ID_OR_URL> [--output <PATH>]
      ./tubedigest --show-transcript <VIDEO_ID_OR_URL>
      ./tubedigest --delete-video <VIDEO_ID_OR_URL>
"""

import os
import sys

# Automatically use local virtual environment if available
_CURRENT_DIR = os.path.dirname(os.path.abspath(__file__))
_VENV_PYTHON = os.path.join(_CURRENT_DIR, ".venv", "bin", "python3")
if sys.prefix == sys.base_prefix and os.path.exists(_VENV_PYTHON):
  os.execv(_VENV_PYTHON, [_VENV_PYTHON] + sys.argv)

import argparse
import datetime
import re
import shutil
import signal
import traceback
from typing import Optional, Set

# Prevent BrokenPipeError when piping output to head or pager on POSIX systems
if hasattr(signal, "SIGPIPE"):
  signal.signal(signal.SIGPIPE, signal.SIG_DFL)

try:
  import tomllib  # Python 3.11+
except ImportError:
  import tomli as tomllib

from core.state_manager import StateManager
from core.tube_digest import TubeDigest, extract_video_id
from core.database import DatabaseManager
from core.ui import UI
from core.models import VideoStatus

CONFIG_FILE = "config.toml"
_ACTIVE_STATE_MANAGER: Optional[StateManager] = None


def global_exception_handler(exc_type, exc_value, exc_tb):
  """Intercepts uncaught exceptions globally, writing tracebacks to log file and clean messages to terminal."""
  if issubclass(exc_type, (KeyboardInterrupt, BrokenPipeError)):
    return

  # Format human-friendly error details
  error_summary = f"{exc_type.__name__}: {exc_value}" if str(exc_value) else exc_type.__name__

  if _ACTIVE_STATE_MANAGER and _ACTIVE_STATE_MANAGER.logger:
    _ACTIVE_STATE_MANAGER.logger.critical(
        f"Uncaught exception encountered: {error_summary}",
        exc_info=(exc_type, exc_value, exc_tb),
    )
  else:
    # Direct file fallback if exception occurred before StateManager initialization
    try:
      os.makedirs("logs", exist_ok=True)
      with open("logs/tubedigest.log", "a", encoding="utf-8") as f:
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        f.write(
            f"[{timestamp}] [CRITICAL] Uncaught exception before StateManager initialization:\n"
        )
        traceback.print_exception(exc_type, exc_value, exc_tb, file=f)
    except Exception:
      pass

  print(
      "\n⚠ An unexpected error occurred while executing TubeDigest.",
      file=sys.stderr,
  )
  print(f"  Reason: {error_summary}", file=sys.stderr)
  print(
      "  Full technical details and traceback have been recorded in the log file (logs/tubedigest.log).\n",
      file=sys.stderr,
  )


# Set global exception hook immediately on load
sys.excepthook = global_exception_handler


def load_config() -> dict:
  """Loads the TOML configuration file."""
  if not os.path.exists(CONFIG_FILE):
    raise FileNotFoundError(f"Configuration file '{CONFIG_FILE}' not found! Please create it from 'config.example.toml'.")
  with open(CONFIG_FILE, "rb") as f:
    return tomllib.load(f)


def handle_cli_channels(
    args,
    db: DatabaseManager,
    state_manager: StateManager,
    digest: Optional[TubeDigest] = None,
) -> bool:
  """Handles CLI channel and prompt management arguments. Returns True if handled."""
  if args.list_prompts:
    prompts = db.list_prompts()
    if not prompts:
      state_manager.print_screen(UI.warning("No prompts found in database."))
      return True

    headers = ["Default", "Prompt ID", "Title", "Updated At"]
    rows = []
    for p in prompts:
      rows.append([
          UI.badge_yes_no(p["is_default"]),
          UI.cyan(p["prompt_id"]),
          (p["prompt_title"] or "-")[:32],
          str(p.get("updated_at") or "-")[:19],
      ])
    table = UI.draw_table("Stored AI Prompt Templates (SQLite)", headers, rows)
    footer = [
        UI.banner(),
        table,
        f"  {UI.bold('Total:')} {len(prompts)} prompt template(s)\n",
        UI.tip("View full prompt text: ./tubedigest --show-prompt <PROMPT_ID>\n"),
    ]
    state_manager.print_screen("\n".join(footer))
    return True

  if args.show_prompt:
    prompt = db.get_prompt_details(args.show_prompt)
    if not prompt:
      state_manager.log_error(f"Prompt '{args.show_prompt}' not found in database.")
      state_manager.print_screen(UI.tip("List available prompts: ./tubedigest --list-prompts"))
      return True

    meta = "\n".join([
        f"{UI.bold('ID'):<15}: {UI.cyan(prompt['prompt_id'])}",
        f"{UI.bold('Title'):<15}: {prompt['prompt_title'] or '-'}",
        f"{UI.bold('Is Default'):<15}: {UI.badge_yes_no(prompt['is_default'])}",
        f"{UI.bold('Updated At'):<15}: {prompt.get('updated_at') or '-'}",
    ])
    panel_meta = UI.draw_panel(f"Prompt Template: {prompt['prompt_id']}", meta)
    panel_prompt = UI.draw_panel("AI Summary Prompt Template", prompt["prompt_text"])
    panel_email = UI.draw_panel("Email HTML Layout Template", prompt.get("email_template") or "(Using default system HTML layout)")
    state_manager.print_screen("\n" + panel_meta + "\n\n" + panel_prompt + "\n\n" + panel_email + "\n")
    return True

  if args.add_channel:
    raw_target = args.add_channel.strip()
    channel_name = args.name
    prompt_id = args.prompt or "default"
    output_language = getattr(args, "output_language", None)
    if output_language:
      output_language = output_language.strip().lower()

    state_manager.log_message(f"Resolving YouTube channel for '{raw_target}'...")
    resolved = digest.resolve_channel_target(raw_target) if digest else None

    if not resolved or not resolved.get("channel_id"):
      state_manager.log_error(
          f"Could not resolve a valid YouTube channel from '{raw_target}'.\n"
          "Please provide one of the following:\n"
          "  • Channel ID (e.g. UCBOtZaVafz_5OmUrqJAVStQ)\n"
          "  • Channel URL (e.g. https://www.youtube.com/@MrRIP or /channel/UC...)\n"
          "  • Channel Handle (e.g. @MrRIP or @antirez)\n"
          "  • Any Video URL or Video ID from the channel (e.g. https://www.youtube.com/watch?v=mUw27wG7uFA)"
      )
      return True

    channel_id = resolved["channel_id"]
    channel_title = resolved.get("channel_title")
    author_name = resolved.get("author_name")
    author_url = resolved.get("author_url")

    if not channel_name and channel_title:
      channel_name = channel_title
    elif not channel_name and author_name:
      channel_name = author_name

    db.add_channel(
        channel_id=channel_id,
        channel_name=channel_name,
        prompt_id=prompt_id,
        author_name=author_name,
        author_url=author_url,
        channel_title=channel_title,
        output_language=output_language,
    )
    name_display = f" '{channel_name}'" if channel_name else ""
    author_display = f" by '{author_name}'" if author_name else ""
    lang_display = f" in language '{output_language}'" if output_language else ""
    prompt_display = f" using prompt '{prompt_id}'"
    resolved_from = resolved.get("resolved_from")
    resolved_display = f" [resolved from {resolved_from}]" if resolved_from and resolved_from != "channel_id" else ""
    state_manager.log_message(
        UI.success(f"Channel{name_display} ({UI.cyan(channel_id)}) added/updated successfully{author_display}{lang_display}{prompt_display}{resolved_display}.")
    )
    return True

  if getattr(args, "set_language", None):
    ch_target, new_lang = args.set_language
    new_lang_clean = new_lang.strip().lower()
    res = db.set_channel_language(ch_target, new_lang_clean)
    if res and res.get("success"):
      ch_id = res["channel_id"]
      ch_name = res["channel_name"]
      name_str = f" '{ch_name}'" if ch_name else ""
      state_manager.log_message(
          UI.success(f"Channel{name_str} ({UI.cyan(ch_id)}) output language updated to {UI.yellow(new_lang_clean)}.")
      )
    else:
      state_manager.log_error(f"Channel '{ch_target}' not found in database.")
      state_manager.log_message(UI.tip("List available channels: ./tubedigest --list-channels"))
    return True

  if args.disable_channel:
    target = args.disable_channel
    result = db.set_channel_active(target, is_active=False)
    if result and result.get("success"):
      ch_id = result["channel_id"]
      ch_name = result["channel_name"]
      name_str = f" '{ch_name}'" if ch_name else ""
      state_manager.log_message(
          UI.success(f"Channel{name_str} ({UI.cyan(ch_id)}) deactivated successfully. TubeDigest will ignore it during automated checks.")
      )
    else:
      state_manager.log_error(f"Channel '{target}' not found in database.")
      state_manager.log_message(UI.tip("List available channels: ./tubedigest --list-channels"))
    return True

  if args.enable_channel:
    target = args.enable_channel
    result = db.set_channel_active(target, is_active=True)
    if result and result.get("success"):
      ch_id = result["channel_id"]
      ch_name = result["channel_name"]
      name_str = f" '{ch_name}'" if ch_name else ""
      state_manager.log_message(
          UI.success(f"Channel{name_str} ({UI.cyan(ch_id)}) activated successfully. TubeDigest will include it in automated checks.")
      )
    else:
      state_manager.log_error(f"Channel '{target}' not found in database.")
      state_manager.log_message(UI.tip("List available channels: ./tubedigest --list-channels"))
    return True

  if args.delete_channel:
    target = args.delete_channel
    result = db.remove_channel(target)
    if result and result.get("success"):
      ch_id = result["channel_id"]
      ch_name = result["channel_name"]
      name_str = f" '{ch_name}'" if ch_name else ""
      v_count = result["videos_deleted"]
      a_count = result["authors_deleted"]

      lines = [
          UI.success(f"Channel{name_str} ({UI.cyan(ch_id)}) and all associated records deleted successfully:"),
          f"  {UI.gray('•')} {a_count} author profile(s) deleted from 'channel_authors'",
          f"  {UI.gray('•')} {v_count} video archive(s) and transcripts deleted from 'processed_videos'",
          f"  {UI.gray('•')} Channel definition deleted from 'channels'",
      ]
      state_manager.log_message("\n".join(lines))
    else:
      state_manager.log_error(f"Channel '{target}' not found in database.")
      state_manager.log_message(UI.tip("List available channels: ./tubedigest --list-channels"))
    return True

  if args.list_channels:
    channels = db.list_channels()
    if not channels:
      state_manager.print_screen(UI.warning("No channels found in database."))
      state_manager.print_screen(UI.tip("Add a channel: ./tubedigest --add-channel <TARGET> [--lang <LANG>] [--name <NAME>]"))
      return True

    headers = ["Status", "Channel ID", "Channel Name", "Author / Creator", "Language", "Prompt ID"]
    rows = []
    def_lang = getattr(digest, "default_language", "en") if digest else "en"
    for ch in channels:
      ch_lang = ch.get("output_language")
      lang_str = UI.yellow(ch_lang) if ch_lang else UI.gray(f"{def_lang}*")
      rows.append([
          UI.badge_active(ch["is_active"]),
          UI.cyan(ch["channel_id"]),
          (ch["channel_name"] or "Unknown"),
          (ch.get("author_name") or "-"),
          lang_str,
          UI.magenta(ch.get("prompt_id") or "default"),
      ])
    table = UI.draw_table("Tracked YouTube Channels (SQLite)", headers, rows)
    footer = [
        UI.banner(),
        table,
        f"  {UI.bold('Total:')} {len(channels)} channel(s)   {UI.gray('(*inherited from config.toml)')}\n",
        UI.tip("Add channel: ./tubedigest --add-channel <TARGET> [--lang <LANG>] [--name <NAME>]\n"),
    ]
    state_manager.print_screen("\n".join(footer))
    return True

  target_video = getattr(args, "add_video", None) or getattr(args, "video", None)
  if target_video:
    video_id = extract_video_id(target_video)
    if not video_id:
      state_manager.log_error(
          f"Invalid YouTube video identifier '{target_video}'. Please provide an 11-character Video ID or a valid YouTube URL."
      )
      return True

    state_manager.log_message(f"Resolving YouTube metadata for video '{video_id}'...")
    meta = digest.get_video_details(video_id) if digest else None
    if not meta:
      state_manager.log_error(f"Could not retrieve video details for '{video_id}'. Please check your network connection.")
      return True

    v_title = meta.get("video_title") or f"YouTube Video ({video_id})"
    v_url = meta.get("video_url") or f"https://www.youtube.com/watch?v={video_id}"
    v_channel_id = meta.get("channel_id")
    v_author = meta.get("author_name")

    # Verify if the author/channel is tracked in our SQLite database
    channel = db.find_channel_for_video(channel_id=v_channel_id, author_name=v_author)
    if not channel:
      author_desc = f"channel '{v_author or v_channel_id or 'Unknown'}'"
      if v_channel_id and v_author:
        author_desc += f" ({v_channel_id})"
      state_manager.log_error(
          f"Video '{v_title}' ({video_id}) belongs to {author_desc}, which is not present in your tracked channels list."
      )
      state_manager.print_screen(UI.tip(f"Add this channel first using: ./tubedigest --add-channel {video_id} [--name <NAME>]"))
      return True

    ch_label = channel.get("channel_name") or channel["channel_id"]
    if not channel.get("is_active", 1):
      state_manager.log_message(
          f"Notice: Channel '{ch_label}' is marked [DISABLED] in SQLite. Proceeding with explicit single-video processing..."
      )

    author_info = {
        "author_name": v_author or ch_label,
        "author_url": meta.get("author_url") or f"https://www.youtube.com/channel/{channel['channel_id']}",
        "channel_title": ch_label,
    }
    process_single_video(
        video_id=video_id,
        video_title=v_title,
        video_url=v_url,
        channel=channel,
        digest=digest,
        db=db,
        state_manager=state_manager,
        author_info=author_info,
        detected_channel_title=ch_label,
        duration_seconds=meta.get("duration_seconds"),
    )
    return True

  if args.list_videos:
    videos = db.list_processed_videos()
    if not videos:
      state_manager.print_screen(UI.warning("No processed videos found in database."))
      state_manager.print_screen(UI.tip("Videos are archived during runs or with: ./tubedigest --add-video <URL>"))
      return True

    headers = ["Video ID", "Duration", "Status", "Summary", "Channel", "Processed At", "Video Title"]
    rows = []
    for v in videos:
      dur_str = UI.format_duration(v.get("duration_seconds"))
      rows.append([
          UI.cyan(v["video_id"]),
          UI.yellow(dur_str),
          UI.badge_status(v.get("status")),
          UI.badge_yes_no((v.get("summary_len") or 0) > 0),
          (v.get("channel_name") or "-"),
          str(v.get("created_at") or "-"),
          (v.get("video_title") or "Unknown Title"),
      ])
    table = UI.draw_table("Archived Video Summaries (SQLite)", headers, rows)
    footer = [
        UI.banner(),
        table,
        f"  {UI.bold('Total:')} {len(videos)} video(s)\n",
        UI.tip("View details:    ./tubedigest --show-video-details <VIDEO_ID>"),
        UI.tip("View summary:    ./tubedigest --show-summary <VIDEO_ID>"),
        UI.tip("Export markdown: ./tubedigest --export-markdown <VIDEO_ID> [--output <PATH>]"),
        UI.tip("Delete video:    ./tubedigest --delete-video <VIDEO_ID>\n"),
    ]
    state_manager.print_screen("\n".join(footer))
    return True

  if args.show_video_details:
    video_id = extract_video_id(args.show_video_details)
    if not video_id:
      state_manager.log_error(
          f"Invalid YouTube video identifier '{args.show_video_details}'. Please provide an 11-character Video ID or a valid YouTube URL."
      )
      return True

    v = db.get_processed_video(video_id)
    if not v:
      state_manager.log_error(f"Video '{video_id}' not found in processed videos archive.")
      state_manager.print_screen(UI.tip("List available videos: ./tubedigest --list-videos"))
      return True

    title = v.get("video_title") or f"Video ({video_id})"
    channel = v.get("channel_name") or "-"
    author = v.get("author_name") or "-"
    author_str = f" ({author})" if author and author != "-" and author != channel else ""
    channel_display = f"{channel}{author_str}"
    url = v.get("video_url") or f"https://www.youtube.com/watch?v={video_id}"
    status = v.get("status") or VideoStatus.COMPLETED
    created = str(v.get("created_at") or "-")
    sent_at = str(v.get("email_sent_at") or "Pending / Not Sent")

    dur_sec = v.get("duration_seconds")
    duration_str = UI.format_duration(dur_sec)
    duration_display = f"{duration_str} ({dur_sec}s)" if dur_sec else "-"

    transcript = v.get("transcript")
    if transcript and transcript.strip():
      words = len(transcript.split())
      chars = len(transcript)
      transcript_info = f"{UI.green('● Available')} ({words:,} words / {chars:,} chars)"
    else:
      transcript_info = UI.yellow("○ Not Available")

    summary = v.get("summary_markdown")
    if summary and summary.strip():
      summary_info = f"{UI.green('● Generated')} ({len(summary):,} chars)"
    else:
      summary_info = UI.yellow("○ Pending / Not Generated")

    prompt_id = v.get("prompt_id") or "default"
    prompt_title = v.get("prompt_title")
    prompt_display = f"{prompt_id} ({prompt_title})" if prompt_title else prompt_id
    output_lang = v.get("output_language") or "default"

    items = [
        (UI.bold("Video ID"), UI.cyan(video_id)),
        (UI.bold("Title"), UI.bold(title)),
        (UI.bold("Duration"), UI.yellow(duration_display)),
        (UI.bold("Channel"), UI.magenta(channel_display)),
        (UI.bold("Channel ID"), (v.get("channel_id") or "-")),
        (UI.bold("Status"), UI.badge_status(status)),
        (UI.bold("Output Language"), output_lang),
        (UI.bold("Prompt Template"), prompt_display),
        (UI.bold("Transcript"), transcript_info),
        (UI.bold("Summary"), summary_info),
        (UI.bold("Processed At"), created),
        (UI.bold("Email Sent At"), sent_at),
        (UI.bold("Video URL"), UI.blue(url)),
    ]

    table = UI.draw_key_value_table("Video Archive Details (SQLite)", items, headers=("Property", "Value"))
    footer = [
        UI.banner(),
        table,
        "",
        UI.tip(f"View summary:    ./tubedigest --show-summary {video_id}"),
        UI.tip(f"Export markdown: ./tubedigest --export-markdown {video_id} [--output <PATH>]"),
        UI.tip(f"View transcript: ./tubedigest --show-transcript {video_id}"),
        UI.tip(f"Delete video:    ./tubedigest --delete-video {video_id}\n"),
    ]
    state_manager.print_screen("\n".join(footer))
    return True

  if args.show_summary:
    video_id = extract_video_id(args.show_summary)
    if not video_id:
      state_manager.log_error(
          f"Invalid YouTube video identifier '{args.show_summary}'. Please provide an 11-character Video ID or a valid YouTube URL."
      )
      return True

    v = db.get_processed_video(video_id)
    if not v:
      state_manager.log_error(f"Video '{video_id}' not found in processed videos archive.")
      state_manager.print_screen(UI.tip("List available videos: ./tubedigest --list-videos"))
      return True

    summary = v.get("summary_markdown")
    if not summary or not summary.strip():
      state_manager.log_error(f"No summary available for video '{video_id}' (Status: {v.get('status', 'UNKNOWN')}).")
      return True

    title = v.get("video_title") or f"Video ({video_id})"
    channel = v.get("channel_name") or "-"
    author = v.get("author_name") or "-"
    author_str = f" ({author})" if author and author != "-" and author != channel else ""
    channel_display = f"{channel}{author_str}"
    url = v.get("video_url") or f"https://www.youtube.com/watch?v={video_id}"
    status = v.get("status") or VideoStatus.COMPLETED
    created = v.get("created_at") or "-"
    sent_at = v.get("email_sent_at") or "-"

    duration_str = UI.format_duration(v.get("duration_seconds"))
    meta_items = [
        (UI.bold("Video ID"), UI.cyan(video_id)),
        (UI.bold("Title"), UI.bold(title)),
        (UI.bold("Duration"), UI.yellow(duration_str)),
        (UI.bold("Channel"), UI.magenta(channel_display)),
        (UI.bold("Status"), UI.badge_status(status)),
        (UI.bold("Processed At"), str(created)),
        (UI.bold("Email Sent At"), str(sent_at)),
        (UI.bold("URL"), UI.blue(url)),
    ]
    panel_meta = UI.draw_key_value_table("Video Metadata", meta_items, headers=("Property", "Value"))
    rendered_summary = UI.render_markdown(summary.strip())
    term_w = shutil.get_terminal_size((80, 24)).columns
    divider = UI.gray("─" * min(term_w, 100))
    output_block = [
        "",
        panel_meta,
        "",
        rendered_summary,
        "",
        divider,
        UI.tip(f"Export this markdown: ./tubedigest --export-markdown {video_id} [--output <PATH>]\n"),
    ]
    state_manager.print_screen("\n".join(output_block))
    return True

  if args.export_markdown:
    video_id = extract_video_id(args.export_markdown)
    if not video_id:
      state_manager.log_error(
          f"Invalid YouTube video identifier '{args.export_markdown}'. Please provide an 11-character Video ID or a valid YouTube URL."
      )
      return True

    v = db.get_processed_video(video_id)
    if not v:
      state_manager.log_error(f"Video '{video_id}' not found in processed videos archive.")
      state_manager.log_message(UI.tip("List available videos: ./tubedigest --list-videos"))
      return True

    summary = v.get("summary_markdown")
    if not summary or not summary.strip():
      state_manager.log_error(f"No summary available for video '{video_id}' (Status: {v.get('status', 'UNKNOWN')}).")
      return True

    title = v.get("video_title") or f"Video_{video_id}"
    channel = v.get("channel_name") or "Unknown Channel"
    author = v.get("author_name") or ""
    url = v.get("video_url") or f"https://www.youtube.com/watch?v={video_id}"
    created = str(v.get("created_at") or datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))

    # Determine destination file path
    if args.output_file:
      out_path = args.output_file
    else:
      # Default export to exports/ directory with sanitized title
      sanitized_title = re.sub(r'[\\/*?:"<>|]', "", title).strip().replace(" ", "_")
      if not sanitized_title:
        sanitized_title = video_id
      out_dir = "exports"
      os.makedirs(out_dir, exist_ok=True)
      out_path = os.path.join(out_dir, f"{sanitized_title[:60]}.md")

    parent_dir = os.path.dirname(os.path.abspath(out_path))
    if parent_dir:
      os.makedirs(parent_dir, exist_ok=True)

    # Build clean markdown file with YAML frontmatter metadata
    escaped_title = title.replace('"', '\\"')
    frontmatter = [
        "---",
        f'title: "{escaped_title}"',
        f'video_id: "{video_id}"',
        f'video_url: "{url}"',
        f'duration: "{UI.format_duration(v.get("duration_seconds"))}"',
        f'channel: "{channel}"',
    ]
    if author and author != channel:
      frontmatter.append(f'author: "{author}"')
    frontmatter.extend([
        f'date: "{created}"',
        "---",
        "",
        summary.strip(),
        "",
        "---",
        f"*Source: [{url}]({url})*",
        "",
    ])

    file_content = "\n".join(frontmatter)
    with open(out_path, "w", encoding="utf-8") as f:
      f.write(file_content)

    state_manager.log_message(
        UI.success(f"Summary exported successfully to '{UI.cyan(out_path)}' ({len(file_content.encode('utf-8'))} bytes).")
    )
    return True

  if args.show_transcript:
    video_id = extract_video_id(args.show_transcript)
    if not video_id:
      state_manager.log_error(
          f"Invalid YouTube video identifier '{args.show_transcript}'. Please provide an 11-character Video ID or a valid YouTube URL."
      )
      return True

    v = db.get_processed_video(video_id)
    if not v:
      state_manager.log_error(f"Video '{video_id}' not found in processed videos archive.")
      state_manager.print_screen(UI.tip("List available videos: ./tubedigest --list-videos"))
      return True

    transcript = v.get("transcript")
    if not transcript or not transcript.strip():
      state_manager.log_error(f"No transcript available for video '{video_id}'.")
      return True

    title = v.get("video_title") or f"Video ({video_id})"
    channel = v.get("channel_name") or "-"
    url = v.get("video_url") or f"https://www.youtube.com/watch?v={video_id}"

    meta = "\n".join([
        f"{UI.bold('Video ID'):<18}: {UI.cyan(video_id)}",
        f"{UI.bold('Title'):<18}: {UI.bold(title)}",
        f"{UI.bold('Channel'):<18}: {UI.magenta(channel)}",
        f"{UI.bold('URL'):<18}: {UI.blue(url)}",
    ])
    panel_meta = UI.draw_panel("Video Metadata", meta)
    panel_text = UI.draw_panel("Raw Transcript Text", transcript.strip())
    state_manager.print_screen("\n" + panel_meta + "\n\n" + panel_text + "\n")
    return True

  if args.delete_video:
    video_id = extract_video_id(args.delete_video)
    if not video_id:
      state_manager.log_error(
          f"Invalid YouTube video identifier '{args.delete_video}'. Please provide an 11-character Video ID or a valid YouTube URL."
      )
      return True

    deleted_info = db.remove_processed_video(video_id)
    if not deleted_info:
      state_manager.log_error(f"Video '{video_id}' not found in processed videos archive.")
      state_manager.print_screen(UI.tip("List available videos: ./tubedigest --list-videos"))
      return True

    title = deleted_info.get("video_title") or f"Video ({video_id})"
    state_manager.log_message(
        UI.success(f"Video '{UI.bold(title)}' ({UI.cyan(video_id)}) was successfully removed from SQLite database.")
    )
    state_manager.print_screen(UI.tip(f"To re-process this video now, run: ./tubedigest --add-video {video_id}\n"))
    return True

  return False


def process_single_video(
    video_id: str,
    video_title: str,
    video_url: str,
    channel: dict,
    digest: TubeDigest,
    db: DatabaseManager,
    state_manager: StateManager,
    author_info: Optional[dict] = None,
    detected_channel_title: Optional[str] = None,
    duration_seconds: Optional[int] = None,
) -> bool:
  """Processes a single video: checks archive, fetches transcript, summarizes, emails, and archives."""
  channel_id = channel["channel_id"]
  channel_label = detected_channel_title or channel.get("channel_name") or channel_id
  prompt_id = channel.get("prompt_id") or "default"

  # Persist or update author metadata if detected
  if author_info and (author_info.get("author_name") or detected_channel_title):
    db.upsert_channel_author(
        channel_id=channel_id,
        author_name=author_info.get("author_name"),
        author_url=author_info.get("author_url"),
        channel_title=detected_channel_title,
    )

  # Update channel name in DB if official title was discovered
  if detected_channel_title and not channel.get("channel_name"):
    db.update_channel_checked(channel_id, channel_name=detected_channel_title)
    channel_label = detected_channel_title
  else:
    db.update_channel_checked(channel_id)

  tag = UI.tag(channel_label)

  # Check if video was already recorded in SQLite
  existing_video = db.get_processed_video(video_id)
  transcript = None

  if existing_video:
    duration_seconds = duration_seconds or existing_video.get("duration_seconds")
    v_status = existing_video.get("status")
    if v_status == VideoStatus.COMPLETED:
      state_manager.log_message(
          f"{tag} Video '{video_title}' ({UI.cyan(video_id)}) already processed."
      )
      return True
    elif v_status == VideoStatus.NO_TRANSCRIPT:
      state_manager.log_message(
          f"{tag} Video '{video_title}' ({UI.cyan(video_id)}) has no transcript available (previously archived)."
      )
      return True
    elif v_status == VideoStatus.PENDING_EMAIL:
      state_manager.log_message(
          f"{tag} Found video '{video_title}' ({UI.cyan(video_id)}) with cached summary awaiting email dispatch. Checking recovery..."
      )
      cached_summary = existing_video.get("summary_markdown") or ""
      if not cached_summary:
        state_manager.log_error(f"{tag} Pending video '{video_title}' ({video_id}) has no cached summary.")
        return False

      email_template = db.get_email_template(prompt_id)
      if not email_template or not email_template.strip():
        state_manager.log_error(
            f"{tag} Email template is still missing or blank in database for prompt '{prompt_id}'. Skipping email dispatch until template is configured."
        )
        return False

      state_manager.log_message(f"{tag} Email template is ready. Sending email (recovery run)...")
      email_subject = f"{detected_channel_title or channel_label} - {video_title}"
      email_sent = digest.send_email(
          email_subject,
          cached_summary,
          video_url,
          video_id,
          email_template=email_template,
          channel_label=channel_label,
          duration_str=UI.format_duration(duration_seconds),
          language=channel.get("output_language"),
      )
      if email_sent:
        db.mark_video_completed(video_id)
        state_manager.log_message(f"{tag} {UI.success('Video recovered and marked as COMPLETED!')}")
        state_manager.log_message(UI.gray("─" * 60))
        return True
      else:
        state_manager.log_message(
            f"{tag} Email dispatch failed; video remains in PENDING_EMAIL state."
        )
        return False
    elif v_status == VideoStatus.PENDING_SUMMARY:
      cached_transcript = existing_video.get("transcript") or ""
      if cached_transcript:
        state_manager.log_message(
            f"{tag} Found video '{video_title}' ({UI.cyan(video_id)}) with cached transcript awaiting AI summary. Reusing cached transcript..."
        )
        transcript = cached_transcript
      else:
        state_manager.log_message(
            f"{tag} Video '{video_title}' ({UI.cyan(video_id)}) marked as PENDING_SUMMARY but transcript is empty in DB. Re-downloading transcript..."
        )

  if duration_seconds is None:
    duration_seconds = digest.get_video_duration(video_id)

  dur_tag = f" [Duration: {UI.yellow(UI.format_duration(duration_seconds))}]" if duration_seconds else ""
  if transcript is None:
    state_manager.log_message(f"{tag} Found new video: {UI.bold(video_title)} ({UI.cyan(video_id)}){dur_tag}")
    state_manager.log_message(f"{tag} Downloading transcript...")
    ch_lang = channel.get("output_language")
    preferred_langs = [ch_lang] if ch_lang else None
    transcript = digest.get_transcript(video_id, preferred_languages=preferred_langs)
    if duration_seconds is None and hasattr(digest, "_last_transcript_duration") and digest._last_transcript_duration:
      duration_seconds = digest._last_transcript_duration

  if transcript:
    ch_lang = channel.get("output_language")
    lang_info = f" [Language: {UI.yellow(ch_lang)}]" if ch_lang else ""
    state_manager.log_message(f"{tag} Generating summary with Gemini (Prompt: {UI.magenta(prompt_id)}){lang_info}...")
    prompt_template = db.get_prompt_text(prompt_id)
    sunto_markdown = digest.summarize_transcript(
        video_title,
        transcript,
        prompt_template=prompt_template,
        output_language=ch_lang,
    )

    if not sunto_markdown:
      db.save_processed_video(
          video_id=video_id,
          channel_id=channel_id,
          video_title=video_title,
          video_url=video_url,
          transcript=transcript,
          summary_markdown="",
          status=VideoStatus.PENDING_SUMMARY,
          duration_seconds=duration_seconds,
      )
      state_manager.log_error(
          f"{tag} Summarization failed; transcript cached as PENDING_SUMMARY in DB. Will retry on next run without re-downloading transcript."
      )
      return False

    email_subject = f"{detected_channel_title or channel_label} - {video_title}"
    email_template = db.get_email_template(prompt_id)

    # If email template is missing or blank, cache summary as PENDING_EMAIL immediately
    if not email_template or not email_template.strip():
      db.save_processed_video(
          video_id=video_id,
          channel_id=channel_id,
          video_title=video_title,
          video_url=video_url,
          transcript=transcript,
          summary_markdown=sunto_markdown,
          status=VideoStatus.PENDING_EMAIL,
          duration_seconds=duration_seconds,
      )
      state_manager.log_error(
          f"{tag} Email template missing or blank in database for prompt '{prompt_id}'. Video summary cached as PENDING_EMAIL for automatic recovery on next run."
      )
      return False

    state_manager.log_message(f"{tag} Sending email...")
    email_sent = digest.send_email(
        email_subject,
        sunto_markdown,
        video_url,
        video_id,
        email_template=email_template,
        channel_label=channel_label,
        duration_str=UI.format_duration(duration_seconds),
        language=channel.get("output_language"),
    )

    if not email_sent:
      # Email failed (e.g. SMTP drop); save as PENDING_EMAIL so Gemini call is not wasted
      db.save_processed_video(
          video_id=video_id,
          channel_id=channel_id,
          video_title=video_title,
          video_url=video_url,
          transcript=transcript,
          summary_markdown=sunto_markdown,
          status=VideoStatus.PENDING_EMAIL,
          duration_seconds=duration_seconds,
      )
      state_manager.log_message(
          f"{tag} Email dispatch failed; video summary cached as PENDING_EMAIL for automatic recovery on next run."
      )
      return False

    # Archive video, transcript, and summary in SQLite
    db.save_processed_video(
        video_id=video_id,
        channel_id=channel_id,
        video_title=video_title,
        video_url=video_url,
        transcript=transcript,
        summary_markdown=sunto_markdown,
        status=VideoStatus.COMPLETED,
        duration_seconds=duration_seconds,
    )
    state_manager.log_message(f"{tag} {UI.success('Video archived and processed successfully!')}")
    state_manager.log_message(UI.gray("─" * 60))
    return True
  else:
    state_manager.log_message(
        f"{tag} Transcript not available for video ({UI.cyan(video_id)}). Archiving status."
    )
    db.save_processed_video(
        video_id=video_id,
        channel_id=channel_id,
        video_title=video_title,
        video_url=video_url,
        transcript="",
        summary_markdown="",
        status=VideoStatus.NO_TRANSCRIPT,
        duration_seconds=duration_seconds,
    )
    return True


def recover_pending_channel_videos(
    channel: dict,
    db: DatabaseManager,
    digest: TubeDigest,
    state_manager: StateManager,
) -> Set[str]:
  """Recovers and dispatches any videos in PENDING_SUMMARY or PENDING_EMAIL state for the given channel.

  Returns the set of video IDs that were handled during recovery.
  """
  channel_id = channel["channel_id"]
  channel_label = channel.get("channel_name") or channel_id
  prompt_id = channel.get("prompt_id") or "default"
  tag = UI.tag(channel_label)

  handled_video_ids: Set[str] = set()

  # 1. Recover videos in PENDING_SUMMARY state (retry Gemini AI summary using cached transcript)
  pending_summary_videos = db.get_pending_summary_videos(channel_id)
  if pending_summary_videos:
    state_manager.log_message(
        f"{tag} Found {len(pending_summary_videos)} pending video(s) awaiting AI summary. Attempting recovery..."
    )
    for psv in pending_summary_videos:
      v_id = psv["video_id"]
      v_title = psv.get("video_title") or f"Video ({v_id})"
      v_url = psv.get("video_url") or f"https://www.youtube.com/watch?v={v_id}"
      handled_video_ids.add(v_id)
      process_single_video(
          video_id=v_id,
          video_title=v_title,
          video_url=v_url,
          channel=channel,
          digest=digest,
          db=db,
          state_manager=state_manager,
      )

  # 2. Recover videos in PENDING_EMAIL state (send email using cached summary, skipping AI and YouTube)
  pending_email_videos = db.get_pending_email_videos(channel_id)
  videos_to_email = [v for v in pending_email_videos if v["video_id"] not in handled_video_ids]

  if videos_to_email:
    email_template = db.get_email_template(prompt_id)
    if not email_template or not email_template.strip():
      state_manager.log_error(
          f"{tag} Email template is still missing or blank for prompt '{prompt_id}'. Cannot recover {len(videos_to_email)} pending email video(s) yet."
      )
    else:
      state_manager.log_message(
          f"{tag} Found {len(videos_to_email)} pending video(s) awaiting email dispatch. Attempting recovery..."
      )
      for pv in videos_to_email:
        v_id = pv["video_id"]
        v_title = pv.get("video_title") or f"Video ({v_id})"
        v_url = pv.get("video_url") or f"https://www.youtube.com/watch?v={v_id}"
        sunto = pv.get("summary_markdown") or ""
        handled_video_ids.add(v_id)

        if not sunto:
          state_manager.log_error(f"{tag} Pending video '{v_title}' ({v_id}) has no summary stored; cannot recover.")
          continue

        state_manager.log_message(f"{tag} Sending email (recovery run for '{v_title}')...")
        email_subject = f"{channel_label} - {v_title}"
        email_sent = digest.send_email(
            email_subject,
            sunto,
            v_url,
            v_id,
            email_template=email_template,
            channel_label=channel_label,
            duration_str=UI.format_duration(pv.get("duration_seconds")),
            language=channel.get("output_language"),
        )
        if email_sent:
          db.mark_video_completed(v_id)
          rec_msg = UI.success(
              f"Video '{v_title}' ({UI.cyan(v_id)}) successfully recovered and marked as COMPLETED!"
          )
          state_manager.log_message(f"{tag} {rec_msg}")
          state_manager.log_message(UI.gray("─" * 60))
        else:
          state_manager.log_message(f"{tag} Recovery dispatch failed for video '{v_title}' ({v_id}).")

  return handled_video_ids


def run_pipeline(
    config: dict,
    state_manager: StateManager,
    db: DatabaseManager,
    digest: TubeDigest,
    target_channel: Optional[str] = None,
):
  """Runs the digest check for all active channels or a specific target channel."""
  state_manager.log_message(UI.banner())
  if target_channel:
    channel = db.get_channel(target_channel)
    if not channel:
      state_manager.log_error(f"Channel '{target_channel}' not found in database.")
      state_manager.log_message("List tracked channels using: ./tubedigest --list-channels")
      return
    active_channels = [channel]
    ch_label = channel.get("channel_name") or channel["channel_id"]
    if not channel.get("is_active", 1):
      state_manager.log_message(
          f"Notice: Channel '{ch_label}' is currently marked [DISABLED] in SQLite. Running explicit one-shot check..."
      )
    else:
      state_manager.log_message(f"Starting one-shot check for channel '{ch_label}'...")
  else:
    active_channels = db.get_active_channels()
    if not active_channels:
      state_manager.log_message("No active channels configured in SQLite database.")
      state_manager.log_message("Add a channel using: ./tubedigest --add-channel <TARGET> [--name <NAME>]")
      return
    state_manager.log_message(f"Starting check for {len(active_channels)} active channel(s)...")

  for channel in active_channels:
    channel_id = channel["channel_id"]
    channel_label = channel.get("channel_name") or channel_id

    # 1. Recover any pending videos awaiting AI summary or email dispatch
    handled_ids = recover_pending_channel_videos(channel, db, digest, state_manager)

    tag = UI.tag(channel_label)
    # 2. Check for latest video via RSS
    state_manager.log_message(f"{tag} Checking for latest video...")
    video_url, video_title, video_id, detected_channel_title, author_info = digest.get_latest_video(channel_id)

    if not video_id:
      state_manager.log_message(f"{tag} No new video found to process.")
      continue

    if video_id in handled_ids:
      state_manager.log_message(
          f"{tag} Latest video '{video_title}' ({UI.cyan(video_id)}) was already handled during recovery in this run."
      )
      continue

    process_single_video(
        video_id=video_id,
        video_title=video_title,
        video_url=video_url,
        channel=channel,
        digest=digest,
        db=db,
        state_manager=state_manager,
        author_info=author_info,
        detected_channel_title=detected_channel_title,
    )


def main():
  global _ACTIVE_STATE_MANAGER
  sys.excepthook = global_exception_handler

  parser = argparse.ArgumentParser(
      description="TubeDigest: Automated Multi-Channel YouTube Monitor & Gemini Digest Pipeline."
  )
  parser.add_argument(
      "--add-channel",
      metavar="TARGET",
      help=(
          "Add or update a channel to monitor in SQLite. Accepts a Channel ID (UC...), "
          "Channel URL, handle (@name), or any YouTube video URL/ID from that channel."
      ),
  )
  parser.add_argument(
      "--name",
      metavar="CHANNEL_NAME",
      help="Optional human-readable name for the channel (used with --add-channel).",
  )
  parser.add_argument(
      "--prompt",
      metavar="PROMPT_ID",
      help="Optional ID of prompt template in database (defaults to 'default').",
  )
  parser.add_argument(
      "--lang",
      "--language",
      dest="output_language",
      metavar="LANG",
      help="Optional output summary language for the channel (e.g. 'it', 'en', 'es', 'zh', 'hi'). If omitted, inherits global language from config.toml.",
  )
  parser.add_argument(
      "--set-language",
      nargs=2,
      metavar=("CHANNEL", "LANG"),
      help="Set or update output summary language for a tracked channel (by ID or Name).",
  )
  parser.add_argument(
      "--channel",
      "--check",
      "-c",
      dest="target_channel",
      metavar="CHANNEL",
      help="Run one-shot pipeline check only for the specified channel (by ID or Name) in SQLite.",
  )
  parser.add_argument(
      "--add-video",
      "--video",
      "-v",
      dest="add_video",
      metavar="VIDEO",
      help="Process a specific YouTube video (by ID or full URL). Verifies channel ownership against SQLite before processing.",
  )
  parser.add_argument(
      "--disable-channel",
      "--deactivate-channel",
      dest="disable_channel",
      metavar="CHANNEL",
      help="Deactivate a channel so TubeDigest ignores it during checks (by Channel ID or Name).",
  )
  parser.add_argument(
      "--enable-channel",
      "--activate-channel",
      dest="enable_channel",
      metavar="CHANNEL",
      help="Reactivate a disabled channel in SQLite database (by Channel ID or Name).",
  )
  parser.add_argument(
      "--delete-channel",
      "--remove-channel",
      dest="delete_channel",
      metavar="CHANNEL",
      help="Delete a channel and all its associated records (authors, processed videos, transcripts) by Channel ID or Name.",
  )
  parser.add_argument(
      "--list-channels",
      action="store_true",
      help="List all tracked channels in SQLite database.",
  )
  parser.add_argument(
      "--list-prompts",
      action="store_true",
      help="List all stored AI prompt templates in SQLite database.",
  )
  parser.add_argument(
      "--show-prompt",
      metavar="PROMPT_ID",
      help="Display the full formatted text and details of an AI prompt template.",
  )
  parser.add_argument(
      "--list-videos",
      "--list-summaries",
      dest="list_videos",
      action="store_true",
      help="List all processed videos and summaries stored in SQLite database.",
  )
  parser.add_argument(
      "--show-video-details",
      "--video-details",
      "--video-info",
      "--show-video",
      dest="show_video_details",
      metavar="VIDEO",
      help="Display full metadata and status details for an archived video in a structured table (by Video ID or URL).",
  )
  parser.add_argument(
      "--show-summary",
      dest="show_summary",
      metavar="VIDEO",
      help="Display the AI summary Markdown for an archived video (by Video ID or URL).",
  )
  parser.add_argument(
      "--export-markdown",
      "--export-summary",
      dest="export_markdown",
      metavar="VIDEO",
      help="Export the AI summary to a Markdown file (by Video ID or URL).",
  )
  parser.add_argument(
      "--output",
      "-o",
      dest="output_file",
      metavar="PATH",
      help="Optional output file path when exporting markdown (used with --export-markdown).",
  )
  parser.add_argument(
      "--show-transcript",
      dest="show_transcript",
      metavar="VIDEO",
      help="Display the raw transcript text for an archived video (by Video ID or URL).",
  )
  parser.add_argument(
      "--delete-video",
      "--remove-video",
      dest="delete_video",
      metavar="VIDEO",
      help="Delete an archived video and its transcript/summary from SQLite database (by Video ID or URL).",
  )

  args = parser.parse_args()

  config = load_config()
  storage = config.get("storage", {})

  # Initialize StateManager early so all pipeline operations and errors are logged
  state_manager = StateManager(storage)
  _ACTIVE_STATE_MANAGER = state_manager

  db_path = storage.get("db_path")
  if not db_path:
    raise KeyError("Missing required 'db_path' in [storage] configuration section.")
  templates_dir = storage.get("templates_dir", "templates")
  db = DatabaseManager(db_path=db_path, templates_dir=templates_dir)
  digest = TubeDigest(config, state_manager=state_manager)

  # If a CLI management command was provided, handle it and exit
  if handle_cli_channels(args, db, state_manager, digest):
    return

  # Otherwise run the automated pipeline (all channels or one-shot for single target channel)
  run_pipeline(config, state_manager, db, digest, target_channel=args.target_channel)


if __name__ == "__main__":
  main()
